a = [25, 85, 75, 97, 82, 61, 73, 83, 86, 93]
for i in range(len(a)-1): #первый счётчик
    min = a[i] #минимальное значение
    id_min = i #индекс минимального значения
    for j in range(i+1, len(a)): #второй счётчик который ищет минимальное среди оставшихся
        if min > a[j]: #ищется минимальное
            min = a[j]
            id_min = j
    if id_min != i: #обмен значениями, если был найден не в i-й позиции
        t = a[i]
        a[i] = a[id_min]
        a[id_min] = t
print(a)

